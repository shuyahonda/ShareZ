<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ShareZ.Views.RegionCaptureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Title="Region Capture">

    <Grid Background="Transparent">
        <canvas:CanvasControl x:Name="OverlayCanvas"
                              CreateResources="OverlayCanvas_CreateResources"
                              Draw="OverlayCanvas_Draw"
                              PointerPressed="OverlayCanvas_PointerPressed"
                              PointerMoved="OverlayCanvas_PointerMoved"
                              PointerReleased="OverlayCanvas_PointerReleased" />

        <!-- Info Panel -->
        <StackPanel x:Name="InfoPanel" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,20,0,0" Background="#CC000000" CornerRadius="6" Padding="16,8">
            <TextBlock Text="Click and drag to select a region" Foreground="White" FontSize="14"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Press ESC to cancel" Foreground="#AAAAAA" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Size Info -->
        <Border x:Name="SizeInfo" Background="#CC000000" CornerRadius="4" Padding="8,4"
                HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontFamily="Consolas" />
        </Border>
    </Grid>
</Window>
