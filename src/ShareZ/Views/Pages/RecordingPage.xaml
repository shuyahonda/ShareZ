<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShareZ.Views.Pages.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="800">
            <TextBlock Text="Screen Recording" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Record your screen as video or GIF" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.7" />

            <!-- Recording Controls -->
            <Grid ColumnSpacing="12" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" HorizontalAlignment="Stretch" Height="120"
                        x:Name="VideoRecordButton" Click="VideoRecord_Click" Padding="16">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE7C8;" FontSize="32" x:Name="VideoRecordIcon" Foreground="Red" />
                        <TextBlock x:Name="VideoRecordText" Text="Record Video (MP4)" TextAlignment="Center" />
                        <TextBlock Text="Ctrl+Shift+5" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5" TextAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" HorizontalAlignment="Stretch" Height="120"
                        x:Name="GifRecordButton" Click="GifRecord_Click" Padding="16">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE7C8;" FontSize="32" x:Name="GifRecordIcon" Foreground="Green" />
                        <TextBlock x:Name="GifRecordText" Text="Record GIF" TextAlignment="Center" />
                        <TextBlock Text="Ctrl+Shift+6" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5" TextAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Recording Timer -->
            <Border x:Name="RecordingTimerPanel" Visibility="Collapsed"
                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    CornerRadius="8" Padding="16" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                    <Ellipse Width="12" Height="12" Fill="Red" VerticalAlignment="Center" />
                    <TextBlock x:Name="RecordingTimer" Text="00:00:00" FontSize="28"
                               FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Content="Stop" Click="StopRecording_Click"
                            Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Recording Settings Preview -->
            <TextBlock Text="Recording Settings" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,24,0,0" />

            <Grid ColumnSpacing="16" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Output Folder:" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="OutputFolderText" Opacity="0.7" VerticalAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Video FPS:" VerticalAlignment="Center" />
                <NumberBox Grid.Row="1" Grid.Column="1" x:Name="FpsBox" Value="30" Minimum="1" Maximum="60"
                           SpinButtonPlacementMode="Compact" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="GIF FPS:" VerticalAlignment="Center" />
                <NumberBox Grid.Row="2" Grid.Column="1" x:Name="GifFpsBox" Value="15" Minimum="1" Maximum="30"
                           SpinButtonPlacementMode="Compact" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Capture Cursor:" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Row="3" Grid.Column="1" x:Name="CaptureCursorToggle" IsOn="True" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Record Audio:" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Row="4" Grid.Column="1" x:Name="RecordAudioToggle" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
