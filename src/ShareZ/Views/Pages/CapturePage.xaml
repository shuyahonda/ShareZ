<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShareZ.Views.Pages.CapturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShareZ.Views.Pages">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="800">
            <TextBlock Text="Screen Capture" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Choose a capture mode to take a screenshot" Style="{StaticResource BodyTextBlockStyle}" Opacity="0.7" />

            <!-- Quick Capture Buttons -->
            <Grid ColumnSpacing="12" RowSpacing="12" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Fullscreen -->
                <Button Grid.Column="0" Grid.Row="0" HorizontalAlignment="Stretch" Height="100"
                        Click="CaptureFullscreen_Click" Padding="16">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE740;" FontSize="28" />
                        <TextBlock Text="Fullscreen" TextAlignment="Center" />
                        <TextBlock Text="PrtSc" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5" TextAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Active Window -->
                <Button Grid.Column="1" Grid.Row="0" HorizontalAlignment="Stretch" Height="100"
                        Click="CaptureWindow_Click" Padding="16">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE737;" FontSize="28" />
                        <TextBlock Text="Active Window" TextAlignment="Center" />
                        <TextBlock Text="Alt+PrtSc" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5" TextAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Region -->
                <Button Grid.Column="2" Grid.Row="0" HorizontalAlignment="Stretch" Height="100"
                        Click="CaptureRegion_Click" Padding="16"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE7A8;" FontSize="28" />
                        <TextBlock Text="Region" TextAlignment="Center" />
                        <TextBlock Text="Ctrl+Shift+4" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" TextAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Last Region -->
                <Button Grid.Column="0" Grid.Row="1" HorizontalAlignment="Stretch" Height="100"
                        Click="CaptureLastRegion_Click" Padding="16">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE8B3;" FontSize="28" />
                        <TextBlock Text="Last Region" TextAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Scrolling Capture -->
                <Button Grid.Column="1" Grid.Row="1" HorizontalAlignment="Stretch" Height="100"
                        Click="ScrollingCapture_Click" Padding="16">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE8CB;" FontSize="28" />
                        <TextBlock Text="Scrolling Capture" TextAlignment="Center" />
                        <TextBlock Text="Ctrl+Shift+8" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5" TextAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Auto Capture -->
                <Button Grid.Column="2" Grid.Row="1" HorizontalAlignment="Stretch" Height="100"
                        Click="AutoCapture_Click" Padding="16">
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <FontIcon Glyph="&#xE916;" FontSize="28" />
                        <TextBlock Text="Auto Capture" TextAlignment="Center" />
                        <TextBlock Text="Ctrl+Shift+7" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5" TextAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Recent Captures -->
            <TextBlock Text="Recent Captures" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,24,0,0" />

            <ListView x:Name="RecentCapturesList" MaxHeight="300" SelectionMode="Single"
                      SelectionChanged="RecentCapturesList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B9;" FontSize="24" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" />
                                <TextBlock Text="{Binding Timestamp}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding CaptureType}" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
