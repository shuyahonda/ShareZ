<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShareZ.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="800">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- General -->
            <TextBlock Text="General" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <StackPanel Spacing="12">
                <ToggleSwitch x:Name="StartWithWindowsToggle" Header="Start with Windows" />
                <ToggleSwitch x:Name="MinimizeToTrayToggle" Header="Minimize to system tray" IsOn="True" />
                <ToggleSwitch x:Name="ShowTrayIconToggle" Header="Show system tray icon" IsOn="True" />
            </StackPanel>

            <!-- Capture -->
            <TextBlock Text="Capture" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <Grid RowSpacing="12" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Screenshot folder:" VerticalAlignment="Center" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="ScreenshotFolderBox" Width="400" />
                    <Button Content="Browse" Click="BrowseScreenshotFolder_Click" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="File name pattern:" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="FilePatternBox" Width="400" HorizontalAlignment="Left" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Image format:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ImageFormatBox" SelectedIndex="0" Width="120">
                    <ComboBoxItem Content="PNG" />
                    <ComboBoxItem Content="JPEG" />
                    <ComboBoxItem Content="BMP" />
                    <ComboBoxItem Content="GIF" />
                    <ComboBoxItem Content="TIFF" />
                </ComboBox>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="JPEG quality:" VerticalAlignment="Center" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Slider x:Name="JpegQualityBox" Minimum="1" Maximum="100" Value="90" Width="200" />
                    <TextBlock x:Name="JpegQualityLabel" Text="90%" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Capture cursor:" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Row="4" Grid.Column="1" x:Name="CaptureCursorToggle" IsOn="True" />
            </Grid>

            <!-- Recording -->
            <TextBlock Text="Recording" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <Grid RowSpacing="12" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Recording folder:" VerticalAlignment="Center" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="RecordingFolderBox" Width="400" />
                    <Button Content="Browse" Click="BrowseRecordingFolder_Click" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Video FPS:" VerticalAlignment="Center" />
                <NumberBox Grid.Row="1" Grid.Column="1" x:Name="VideoFpsBox" Value="30" Minimum="1" Maximum="60"
                           SpinButtonPlacementMode="Compact" Width="120" HorizontalAlignment="Left" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="GIF FPS:" VerticalAlignment="Center" />
                <NumberBox Grid.Row="2" Grid.Column="1" x:Name="GifFpsBox" Value="15" Minimum="1" Maximum="30"
                           SpinButtonPlacementMode="Compact" Width="120" HorizontalAlignment="Left" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Record audio:" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Row="3" Grid.Column="1" x:Name="RecordAudioToggle" />
            </Grid>

            <!-- Hotkeys -->
            <TextBlock Text="Hotkeys" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <ListView x:Name="HotkeyList" MaxHeight="400" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding DisplayString}" VerticalAlignment="Center"
                                       FontFamily="Consolas" Opacity="0.7" />
                            <ToggleSwitch Grid.Column="2" IsOn="{Binding IsEnabled}" OnContent="On" OffContent="Off" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Auto Capture -->
            <TextBlock Text="Auto Capture" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,16,0,0" />
            <Grid RowSpacing="8" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Interval (ms):" VerticalAlignment="Center" />
                <NumberBox Grid.Row="0" Grid.Column="1" x:Name="AutoCaptureIntervalBox" Value="5000"
                           Minimum="1000" Maximum="300000" SpinButtonPlacementMode="Compact"
                           Width="160" HorizontalAlignment="Left" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Capture type:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="AutoCaptureTypeBox" SelectedIndex="0" Width="160">
                    <ComboBoxItem Content="Fullscreen" />
                    <ComboBoxItem Content="Active Window" />
                </ComboBox>
            </Grid>

            <!-- Save Button -->
            <Button Content="Save Settings" Click="SaveSettings_Click"
                    Style="{StaticResource AccentButtonStyle}" Margin="0,24,0,0"
                    HorizontalAlignment="Left" />

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,24,0,0" />
            <StackPanel Spacing="4">
                <TextBlock Text="ShareZ v1.0.0" />
                <TextBlock Text="A WinUI 3 screenshot and screen recording tool" Opacity="0.7" />
                <TextBlock Text="Inspired by ShareX" Opacity="0.5" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
