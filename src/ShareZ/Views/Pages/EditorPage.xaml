<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ShareZ.Views.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Editor Toolbar -->
        <Grid Grid.Row="0" Background="{ThemeResource NavigationViewDefaultPaneBackground}" Padding="8" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Drawing Tools -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                <RadioButton x:Name="RectTool" GroupName="Tools" Content="&#xE739;" FontFamily="Segoe MDL2 Assets"
                             Style="{StaticResource ToggleButtonRadioButtonStyle}" Click="Tool_Click" Tag="Rectangle"
                             IsChecked="True" Width="36" Height="36" Padding="0" HorizontalContentAlignment="Center" />
                <RadioButton x:Name="EllipseTool" GroupName="Tools" Content="&#xEA3A;" FontFamily="Segoe MDL2 Assets"
                             Style="{StaticResource ToggleButtonRadioButtonStyle}" Click="Tool_Click" Tag="Ellipse"
                             Width="36" Height="36" Padding="0" HorizontalContentAlignment="Center" />
                <RadioButton x:Name="LineTool" GroupName="Tools" Content="&#xE738;" FontFamily="Segoe MDL2 Assets"
                             Style="{StaticResource ToggleButtonRadioButtonStyle}" Click="Tool_Click" Tag="Line"
                             Width="36" Height="36" Padding="0" HorizontalContentAlignment="Center" />
                <RadioButton x:Name="ArrowTool" GroupName="Tools" Content="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                             Style="{StaticResource ToggleButtonRadioButtonStyle}" Click="Tool_Click" Tag="Arrow"
                             Width="36" Height="36" Padding="0" HorizontalContentAlignment="Center" />
                <RadioButton x:Name="TextTool" GroupName="Tools" Content="&#xE8D2;" FontFamily="Segoe MDL2 Assets"
                             Style="{StaticResource ToggleButtonRadioButtonStyle}" Click="Tool_Click" Tag="Text"
                             Width="36" Height="36" Padding="0" HorizontalContentAlignment="Center" />
                <RadioButton x:Name="FreehandTool" GroupName="Tools" Content="&#xEDFB;" FontFamily="Segoe MDL2 Assets"
                             Style="{StaticResource ToggleButtonRadioButtonStyle}" Click="Tool_Click" Tag="Freehand"
                             Width="36" Height="36" Padding="0" HorizontalContentAlignment="Center" />

                <AppBarSeparator />

                <RadioButton x:Name="BlurTool" GroupName="Tools" Content="Blur"
                             Style="{StaticResource ToggleButtonRadioButtonStyle}" Click="Tool_Click" Tag="Blur"
                             Height="36" Padding="8,0" HorizontalContentAlignment="Center" />
                <RadioButton x:Name="PixelateTool" GroupName="Tools" Content="Pixel"
                             Style="{StaticResource ToggleButtonRadioButtonStyle}" Click="Tool_Click" Tag="Pixelate"
                             Height="36" Padding="8,0" HorizontalContentAlignment="Center" />
                <RadioButton x:Name="HighlightTool" GroupName="Tools" Content="&#xE7E6;" FontFamily="Segoe MDL2 Assets"
                             Style="{StaticResource ToggleButtonRadioButtonStyle}" Click="Tool_Click" Tag="Highlight"
                             Width="36" Height="36" Padding="0" HorizontalContentAlignment="Center" />
                <RadioButton x:Name="StepTool" GroupName="Tools" Content="123"
                             Style="{StaticResource ToggleButtonRadioButtonStyle}" Click="Tool_Click" Tag="Step"
                             Height="36" Padding="8,0" HorizontalContentAlignment="Center" />
                <RadioButton x:Name="CropTool" GroupName="Tools" Content="&#xE7A8;" FontFamily="Segoe MDL2 Assets"
                             Style="{StaticResource ToggleButtonRadioButtonStyle}" Click="Tool_Click" Tag="Crop"
                             Width="36" Height="36" Padding="0" HorizontalContentAlignment="Center" />
            </StackPanel>

            <!-- Color and Size Controls -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0">
                <DropDownButton Content="Color">
                    <DropDownButton.Flyout>
                        <Flyout>
                            <ColorPicker x:Name="StrokeColorPicker" Color="Red"
                                         ColorChanged="StrokeColorPicker_ColorChanged"
                                         IsAlphaEnabled="True" IsHexInputVisible="True" />
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <ComboBox x:Name="StrokeWidthCombo" Header="" Width="80" SelectedIndex="1"
                          SelectionChanged="StrokeWidth_Changed">
                    <ComboBoxItem Content="1px" Tag="1" />
                    <ComboBoxItem Content="2px" Tag="2" />
                    <ComboBoxItem Content="3px" Tag="3" />
                    <ComboBoxItem Content="5px" Tag="5" />
                    <ComboBoxItem Content="8px" Tag="8" />
                    <ComboBoxItem Content="12px" Tag="12" />
                </ComboBox>

                <CheckBox x:Name="FilledCheck" Content="Filled" Click="Filled_Changed" />
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                <Button ToolTipService.ToolTip="Open Image" Click="OpenImage_Click">
                    <FontIcon Glyph="&#xE8E5;" FontSize="14" />
                </Button>
                <AppBarSeparator />
                <Button ToolTipService.ToolTip="Undo (Ctrl+Z)" Click="Undo_Click">
                    <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                </Button>
                <Button ToolTipService.ToolTip="Redo (Ctrl+Y)" Click="Redo_Click">
                    <FontIcon Glyph="&#xE7A6;" FontSize="14" />
                </Button>
                <AppBarSeparator />
                <Button ToolTipService.ToolTip="Copy to Clipboard" Click="CopyClipboard_Click">
                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                </Button>
                <Button ToolTipService.ToolTip="Save" Click="Save_Click">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                </Button>
                <Button ToolTipService.ToolTip="Save As" Click="SaveAs_Click">
                    <FontIcon Glyph="&#xE792;" FontSize="14" />
                </Button>
                <Button Content="Upload" Click="Upload_Click" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Canvas Area -->
        <Border Grid.Row="1" Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}">
            <Grid>
                <!-- Placeholder when no image is loaded -->
                <StackPanel x:Name="PlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE8B9;" FontSize="48" Opacity="0.3" />
                    <TextBlock Text="Open an image or capture a screenshot to start editing"
                               Opacity="0.5" TextAlignment="Center" />
                    <Button Content="Open Image" Click="OpenImage_Click"
                            Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" />
                </StackPanel>

                <ScrollViewer x:Name="EditorScrollViewer" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="10"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <canvas:CanvasControl x:Name="EditorCanvas"
                                          Draw="EditorCanvas_Draw"
                                          PointerPressed="EditorCanvas_PointerPressed"
                                          PointerMoved="EditorCanvas_PointerMoved"
                                          PointerReleased="EditorCanvas_PointerReleased"
                                          CreateResources="EditorCanvas_CreateResources" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Grid Grid.Row="2" Height="28" Background="{ThemeResource NavigationViewDefaultPaneBackground}" Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="EditorStatus" Text="Open an image to start editing" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
            <TextBlock x:Name="CursorPosition" Grid.Column="1" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5" Margin="8,0" />
            <TextBlock x:Name="ImageSize" Grid.Column="2" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.5" />
        </Grid>
    </Grid>
</Page>
